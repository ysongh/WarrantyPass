# Copy this file to .env and fill in the values.
#
# Everything prefixed VITE_ is embedded in the client bundle and is publicly
# readable. Only public configuration belongs here — never a Supabase
# service-role key, and never any private API key or secret.

# Supabase project URL, e.g. https://your-project.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe to expose; access is restricted by row-level
# security on the database, not by keeping this key secret.
VITE_SUPABASE_ANON_KEY=

# Optional. Sepolia RPC endpoint. Leave blank to use the default public RPC,
# which works but is rate-limited. Use a provider URL for anything sustained.
VITE_SEPOLIA_RPC_URL=
