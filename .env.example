# Copy this file to .env and fill in the values.
#
# Everything prefixed VITE_ is embedded in the client bundle and is publicly
# readable. Only public configuration belongs here — never a Supabase
# service-role key, and never any private API key or secret.

# Supabase project URL, e.g. https://your-project.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key. Safe to expose; access is restricted by row-level
# security on the database, not by keeping this key secret.
VITE_SUPABASE_ANON_KEY=

# The project also needs Anonymous Sign-Ins enabled (Authentication -> Sign In /
# Providers) and the migration in supabase/migrations/ applied. There is no
# environment variable for either — see docs/data-model.md.

# The AI provider key for receipt scanning is deliberately NOT here. It is an
# Edge Function secret, set with `supabase secrets set ANTHROPIC_API_KEY=...`,
# and must never be given a VITE_ prefix — that would compile it into the
# bundle for anyone to read. See docs/data-model.md.

# Optional. Arc Testnet RPC endpoint. Leave blank to use the default public RPC
# (https://rpc.testnet.arc.network), which works but is rate-limited.
VITE_ARC_TESTNET_RPC_URL=

# The deployed WarrantyPassRegistry address on Arc Testnet, e.g. 0xabc...123.
# A contract address is public information and safe to expose here.
#
# Leave blank until the registry is deployed. An unset address means onchain
# proof is unavailable and the UI says so — it must never fall back to a
# hardcoded or guessed address, which would point at a contract that is not
# ours while looking like it worked.
VITE_WARRANTY_PASS_REGISTRY_ADDRESS=

# Deployment secrets are deliberately NOT in this file. DEPLOYER_PRIVATE_KEY
# and ARC_TESTNET_RPC_URL (the deploy-time one) are used by `forge script` only,
# never by the browser, and must never take a VITE_ prefix — a
# VITE_DEPLOYER_PRIVATE_KEY would compile a funded key into a public bundle.
# See docs/deployment.md.
